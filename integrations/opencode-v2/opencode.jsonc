{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*opencode.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.opencode/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm publish *",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "integration.connect",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "integration.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plugin.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.env",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*.env.*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.env",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*.env.*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*opencode.json",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rm -rf *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:npm publish *",
      "effect": "deny"
    }
  ]
}
